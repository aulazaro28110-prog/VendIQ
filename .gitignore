# Artefactos generados: se reconstruyen ejecutando los pasos 01 y 02.
# No se versionan porque son binarios grandes y cambian en cada ejecución.
salida/embeddings.npy
salida/embeddings_meta.json
salida/chunks.jsonl
salida/chroma/

# El registro de ofertas es datos de trabajo, no código.
salida/ofertas.json

# Detalle del banco de conversaciones: se regenera con
#   python tests/test_conversaciones.py --json salida/conversaciones.json
salida/conversaciones.json
salida/precios_fijados.json

# CLAVES. Nunca al repositorio. Ver docs/CONFIGURAR_GROQ.md
.env
.env.*
!.env.ejemplo

# Registro de dudas: es actividad, no código. Se regenera solo.
salida/no_resueltas.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Cuarentena de basura, no versionar
_to_delete/

# Reservas de conversaciones: datos de trabajo, no codigo.
salida/reservas.json

# Conversaciones abiertas del panel. Llevan matriculas en claro: nunca al repo.
salida/sesiones.json
salida/sesiones.json.tmp

# Copias de seguridad del redactor: el original ya esta en git.
*.bak*

# Transcripcion de tests/test_frio.py: se regenera en cada tirada.
salida/frio.txt

# Transcripciones de tiradas de los bancos: se regeneran en cada ejecucion.
salida/*.txt

# Borradores y notas de trabajo. No son documentacion de VendIQ: describen el
# sistema como aun no construido y lo contradicen. Uno nombra ademas al
# proveedor real del cliente. docs/ publica solo .md.
docs/*.html
docs/VendIQ_Bases_y_Posicionamiento.md

# Encargo de trabajo ya cumplido: las 5 tareas que pedia estan implementadas y
# medidas. Es una lista de tareas terminada, no documentacion del repo.
docs/PROMPT_VSCODE_conversacion.md

# Depuracion de un dia concreto (por que "envias a canarias?" escalaba). Nada
# lo referencia y termina pidiendo que le pegues la salida a alguien.
scripts/diag_canarias.py

# Salidas de depuracion de tests (temporales)
err_*.txt

# Prompt de trabajo para reconstruir el panel en otro sitio. Es una herramienta
# mia, no documentacion de VendIQ: describe el panel como encargo, no como lo
# que es. Mismo criterio que docs/PROMPT_VSCODE_conversacion.md.
docs/PROMPT_panel_duplicar.md

# Salida del banco de guiones: se regenera con
#   python tests/test_guiones.py --json salida/guiones_banco.json
salida/guiones_banco.json

# Prompts de trabajo de «conversaciones tipo» (el encargo y su cierre).
# Describen tareas, no el sistema. Mismo criterio que los otros PROMPT_*.
docs/PROMPT_VSCODE_conversaciones_tipo_y_porque.md

# Notas y prompts de trabajo sueltos en la raiz: el encargo de «conversaciones
# tipo», su cierre y un manual de pruebas manuales. Son herramientas mias para
# construir VendIQ, no documentacion del sistema. Mismo criterio que los PROMPT_*.
CIERRE_VendIQ_Prompt.md
PROMPT_VSCODE_conversaciones_tipo_y_porque.md
VendIQ_Manual_Conversacion_Multiturno.md

# Material privado de trabajo: prompts, encargos, especificaciones, notas y
# borradores. Son herramientas mías para construir VendIQ, no documentación
# del sistema, y alguno nombra datos que no pueden ser públicos. Todo vive en
# esta carpeta; las reglas sueltas de arriba se quedan por si alguno vuelve a
# su sitio de antes.
_privado/
